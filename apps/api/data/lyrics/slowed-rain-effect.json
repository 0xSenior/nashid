    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 6224,
      "ar": "نُورُ اللهِ هَادِينَا",
      "en": "The light of God guides us",
      "fr": "La lumière de Dieu nous guide",
      "ru": "Свет Аллаха нас направляет",
      "de": "Das Licht Gottes leitet uns",
      "id": "Cahaya Allah membimbing kita",
      "nl": "Het licht van God leidt ons",
      "ckb": "ڕووناکی خوا ڕێنماییمان دەکات",
      "fa": "نور خدا راهنمای ماست"
    },
    {
      "lineIndex": 1,
      "startMs": 6224,
      "endMs": 9234,
      "ar": "وَالْفَرْحَةُ تَحْيِينَا",
      "en": "And joy revives us",
      "fr": "Et la joie nous anime",
      "ru": "И радость оживляет нас",
      "de": "Und die Freude belebt uns",
      "id": "Dan kegembiraan menghidupkan kita",
      "nl": "En vreugde doet ons herleven",
      "ckb": "و خۆشی زیندومان دەکاتەوە",
      "fa": "و شادی ما را زنده می‌سازد"
    },
    {
      "lineIndex": 2,
      "startMs": 9234,
      "endMs": 12246,
      "ar": "وَالْبَسْمَةُ تُغَنِّينَا",
      "en": "And a smile enriches us",
      "fr": "Et le sourire nous suffit",
      "ru": "И улыбка нас обогащает",
      "de": "Und das Lächeln bereichert uns",
      "id": "Dan senyuman mencukupi kita",
      "nl": "En een glimlach verrijkt ons",
      "ckb": "و زەردەخەنە دەوڵەمەندمان دەکات",
      "fa": "و لبخند ما را بی‌نیازی می‌بخشد"
    },
    {
      "lineIndex": 3,
      "startMs": 12246,
      "endMs": 15257,
      "ar": "وَالدُّنْيَا بِأَيْدِينَا",
      "en": "And the world is in our hands",
      "fr": "Et le monde est entre nos mains",
      "ru": "И весь мир в наших руках",
      "de": "Und die Welt liegt in unseren Händen",
      "id": "Dan dunia ada di tangan kita",
      "nl": "En de wereld is in onze handen",
      "ckb": "و دنیا لە دەستماندایە",
      "fa": "و جهان در دست‌های ماست"
    },

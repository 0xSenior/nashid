  "lines": [
    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 6129,
      "ar": "•ومالي وللدنيا وليست ببغيتــــــي",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "منی چی و دونیام چی، کە نە مەبەستمە"
    },
    {
      "lineIndex": 1,
      "startMs": 6129,
      "endMs": 10733,
      "ar": "ولا منتهى قصدي و لست أنا لــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "نە دوا ئامانجمە و نە من بۆ ئەو دروست بووم"
    },
    {
      "lineIndex": 2,
      "startMs": 10733,
      "endMs": 15497,
      "ar": "•ولست بميــــــال إليــــــها ولا إلى",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "نە ئارەزووی دەکەم و نە بەرەو"
    },
    {
      "lineIndex": 3,
      "startMs": 15497,
      "endMs": 19398,
      "ar": "رئاســــــتها نتنا وقبحا لحالـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "سەرکردایەتی و دەسەڵاتەکەی دێم، کە چەند بۆنگەن و ناشیرینە دۆخی!"
    },
    {
      "lineIndex": 4,
      "startMs": 19398,
      "endMs": 23624,
      "ar": "•هي الدار دار الهم والغم والعنـــــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەو ماڵە ماڵی خەم و پەژارە و ئازارە"
    },
    {
      "lineIndex": 5,
      "startMs": 23624,
      "endMs": 28013,
      "ar": "سريع تقضيــــــها قريب زوالـــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەخێرایی بەسەر دەچێت و لەناوچوونی نزیکە"
    },
    {
      "lineIndex": 6,
      "startMs": 28013,
      "endMs": 32257,
      "ar": "•مياسيرها عسر وحزن سرورهـــــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئاسانییەکانی دژوارییە و خۆشییەکەی خەمە"
    },
    {
      "lineIndex": 7,
      "startMs": 32257,
      "endMs": 36666,
      "ar": "وأرباحها خسر ونقص كمالـــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "قازانجەکانی زەرەرە و کەماڵەکەی کەموکوڕییە"
    },
    {
      "lineIndex": 8,
      "startMs": 36666,
      "endMs": 40721,
      "ar": "•إذا أضحكت أبكت وإن رام وصلها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەگەر بیخەنێنێت دەیگریەنێت، و ئەگەر ئاواتی گەیشتن بەوی هەبێت"
    },
    {
      "lineIndex": 9,
      "startMs": 40721,
      "endMs": 45096,
      "ar": "غبي فيا سرع انقطاع وصالــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "نەفامێک، ئەوا چەند بەخێرایی پەیوەندییەکەی دەپچڕێت!"
    },
    {
      "lineIndex": 10,
      "startMs": 45096,
      "endMs": 50825,
      "ar": "•فأسأل ربي أن يحــــــــــول بحوله",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "داوا لە پەروەردگارم دەکەم بە توانای خۆی"
    },
    {
      "lineIndex": 11,
      "startMs": 50825,
      "endMs": 53646,
      "ar": "وقوتـــــه بيني و بين اغتيالــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و هێزی خۆی بێتە نێوان من و هەڵخەڵەتاندنە کوشتندەکەی"
    },
    {
      "lineIndex": 12,
      "startMs": 53646,
      "endMs": 58163,
      "ar": "•فيا طالـــــــب الدنيا الدنيئة جاهدا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەی ئەو کەسەی بە هەوڵدانەوە داوای دونیای نزم دەکەیت"
    },
    {
      "lineIndex": 13,
      "startMs": 58163,
      "endMs": 62235,
      "ar": "ألا اطلب سواها إنها لا وفا لـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بزانە داوای جگه لەو بکە، چونکە وەفای نییە"
    },
    {
      "lineIndex": 14,
      "startMs": 62235,
      "endMs": 66322,
      "ar": "•فكم قد رأينا من حريص و مشـفق",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "جا چەندین کەسی بپەرۆش و خەمخۆرمان دیوە"
    },
    {
      "lineIndex": 15,
      "startMs": 66322,
      "endMs": 70717,
      "ar": "عليها فلم يظفر بها أن ينالـــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "لەسەری، بەڵام سەرکەوتوو نەبوو لە بەدەستهێنانی"
    },
    {
      "lineIndex": 16,
      "startMs": 70717,
      "endMs": 74980,
      "ar": "•لقد جاء في آي الحديد و يونــس",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەڕاستی لە ئایەتەکانی حەدید و یوونسدا هاتوو"
    },
    {
      "lineIndex": 17,
      "startMs": 74980,
      "endMs": 79581,
      "ar": "وفي الكهف إيضاح بضرب مثالـــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لە کەهفدا روونکردنەوە دراوە بە هێنانەوەی وێنەی"
    },
    {
      "lineIndex": 18,
      "startMs": 79581,
      "endMs": 83606,
      "ar": "•وفي آل عمران و سورة فاطـــــر",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لە ئالی عیمران و سورەتی فاتیڕدا"
    },
    {
      "lineIndex": 19,
      "startMs": 83606,
      "endMs": 88004,
      "ar": "وفي غافر قد جاء تبيان حالـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لە غافیردا روونکردنەوەی حاڵی هاتووە"
    },
    {
      "lineIndex": 20,
      "startMs": 88004,
      "endMs": 92044,
      "ar": "•وفي سورة الأحقاف أعظم واعظ",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لە سورەتی ئەحقافدا گەورەترین ئامۆژگاریکەر هەیە"
    },
    {
      "lineIndex": 21,
      "startMs": 92044,
      "endMs": 96398,
      "ar": "وكم من حديث موجب لاعتزالـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و چەندین فەرموودە هەن کە پێویستی دەکەن لێی دووربکەویتەوە"
    },
    {
      "lineIndex": 22,
      "startMs": 96398,
      "endMs": 100831,
      "ar": "•لقد نظروا قوم بعين بصــــــــــيرة",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەڕاستی کۆمەڵێک خەڵک بە چاوی ژیرییەوە تەماشایان کرد"
    },
    {
      "lineIndex": 23,
      "startMs": 100831,
      "endMs": 104796,
      "ar": "إليها فلم تغررهم باختيالــــــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەرەو ئەو، بۆیە بە ناز و فیزەکەی نەیخەڵەتاندن"
    },
    {
      "lineIndex": 24,
      "startMs": 104796,
      "endMs": 110038,
      "ar": "•أولئك أهل الله حقا وحزبــــــــه",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەوانە بەڕاستی کەسوکاری خوا و کۆمەڵەکەی ئەون"
    },
    {
      "lineIndex": 25,
      "startMs": 110038,
      "endMs": 113651,
      "ar": "لهم جنة الفردوس إرثا و يالــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەهەشتی فردۆس بۆ ئەوانە وەک میرات، ئای چەند بەهەشتێکی خۆشە!"
    },
    {
      "lineIndex": 26,
      "startMs": 113651,
      "endMs": 117644,
      "ar": "•ومال إليها آخرون لجهلــــــهم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و کەسانی تر بەهۆی نەزانییانەوە پشتیان پێ بەست"
    },
    {
      "lineIndex": 27,
      "startMs": 117644,
      "endMs": 121935,
      "ar": "فلما اطمئنوا أرشقتهم نبالـــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "کاتێک دڵنیا بوون، تیرەکانی خۆی پێوە نان"
    },
    {
      "lineIndex": 28,
      "startMs": 121935,
      "endMs": 127091,
      "ar": "•أولئك قوم آثروها فأعقــــــــبوا بها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەوانە کۆمەڵێکن کە ئەو دونیایەیان هەڵبژارد، بۆیە دوای ئەوە تووشی"
    },
    {
      "lineIndex": 29,
      "startMs": 127091,
      "endMs": 130166,
      "ar": "الخزي في الأخرى و ذاقوا وبالها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "شەرمەزاری بوون لە دواڕۆژدا و چەشتیان سزاکەی"
    },
    {
      "lineIndex": 30,
      "startMs": 130166,
      "endMs": 135277,
      "ar": "•فقل للذين استعذبوها رويدكــــم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەوانە بڵێ کە بە خۆشیان دەزانی: لەسەرخۆ بن"
    },
    {
      "lineIndex": 31,
      "startMs": 135277,
      "endMs": 138647,
      "ar": "سينقلب السم النقيع زلالـــــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ژەهرە خەستەکەی دێتە جێگەی ئاوە زوڵاڵەکەی"
    },
    {
      "lineIndex": 32,
      "startMs": 138647,
      "endMs": 143095,
      "ar": "•ليلهوا و يغتروا بها ما بدا لـهم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "با یاری بکەن و پێی هەڵبخەڵەتێن تا ئەو کاتەی بۆیان دەردەکەوێت"
    },
    {
      "lineIndex": 33,
      "startMs": 143095,
      "endMs": 147039,
      "ar": "متى تبلغ الحلقوم تصرم حبالـــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "کاتێک گیان دەگاتە گەروو، پەتەکانی دەپچڕێت"
    },
    {
      "lineIndex": 34,
      "startMs": 147039,
      "endMs": 151304,
      "ar": "•ويوم توفى كل نفس بكسبــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لەو ڕۆژەی کە هەر نەفسێک پاداشتی کردەوەکانی دەدرێتەوە"
    },
    {
      "lineIndex": 35,
      "startMs": 151304,
      "endMs": 155750,
      "ar": "تود فداء لو بينها و ما لــــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئاوات دەخوازێت کاشکی لە نێوان خۆی و ماڵەکەیدا جیاوازی هەبووایە"
    },
    {
      "lineIndex": 36,
      "startMs": 155750,
      "endMs": 159988,
      "ar": "•وتأخذ إما باليمين كتابـــــــها إذا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و نامەکەی یان بە دەستی ڕاست وەردەگرێت ئەگەر"
    },
    {
      "lineIndex": 37,
      "startMs": 159988,
      "endMs": 164267,
      "ar": "أحسنت أو ضد ذا بشمالــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "چاکەی کردبێت، یان بە پێچەوانەی ئەوە بە دەستی چەپی"
    },
    {
      "lineIndex": 38,
      "startMs": 164267,
      "endMs": 168338,
      "ar": "•ويبدو لديها ما أسرت و أعلنت",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و بۆی دەرەکەوێت ئەوەی شاردیبوویەوە و ئاشکرای کردبوو"
    },
    {
      "lineIndex": 39,
      "startMs": 168338,
      "endMs": 174623,
      "ar": "وما قدمت من قولها و فعالـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ئەوەی پێشکەشی کردبوو لە وتار و کرداری"
    },
    {
      "lineIndex": 40,
      "startMs": 174623,
      "endMs": 176873,
      "ar": "•بأيدي الكرام الكاتبين مسطـــــر",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بە دەستی نووسەرە بەڕێزەکان تۆمار کراوە"
    },
    {
      "lineIndex": 41,
      "startMs": 176873,
      "endMs": 181172,
      "ar": "فلم يغن عنها عذرها و جدالـــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئیتر عوزر و دەمەقاڵێی سوودی بۆ ناهێنێت"
    },
    {
      "lineIndex": 42,
      "startMs": 181172,
      "endMs": 185452,
      "ar": "•هنالك تدري ربحها و خسارهــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "لەوێدا دەزانێت قازانج و زەرەری خۆی"
    },
    {
      "lineIndex": 43,
      "startMs": 185452,
      "endMs": 189541,
      "ar": "وإذ ذاك تلقى ما إليه مآلــــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و لەو کاتەدا ڕووبەڕووی سەرئەنجامی خۆی دەبێتەوە"
    },
    {
      "lineIndex": 44,
      "startMs": 189541,
      "endMs": 193686,
      "ar": "•فإن تك من أهل السعادة و التقى",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئینجا ئەگەر لە ئەهلی بەختەوەری و تەقوا بێت"
    },
    {
      "lineIndex": 45,
      "startMs": 193686,
      "endMs": 197978,
      "ar": "فإن لها الحسنى بحسن فعالــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئەوا پاداشتی چاکی دەبێت بەهۆی چاکی کردەوەکانی"
    },
    {
      "lineIndex": 46,
      "startMs": 197978,
      "endMs": 202430,
      "ar": "•تفوز بجنات النعيم و حورهــــــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "سەردەکەوێت بە بەهەشتەکانی خۆشی و حۆرییەکانی"
    },
    {
      "lineIndex": 47,
      "startMs": 202430,
      "endMs": 206507,
      "ar": "وتحبر في روضاتها و ظلالـــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و دڵخۆش دەبێت لە باخچەکان و سێبەرەکانیدا"
    },
    {
      "lineIndex": 48,
      "startMs": 206507,
      "endMs": 210845,
      "ar": "•وترزق مما تشتهي من نعيمــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ڕۆزی دەدرێت لەوەی ئارەزووی دەکات لە خۆشییەکانی"
    },
    {
      "lineIndex": 49,
      "startMs": 210845,
      "endMs": 215035,
      "ar": "وتشرب من تسنيمها و زلالـــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و دەخواتەوە لە ئەوی تەسنیم و ئاوە زوڵاڵەکەی"
    },
    {
      "lineIndex": 50,
      "startMs": 215035,
      "endMs": 219755,
      "ar": "•وإن لهم يوم المزيد لموعــــــدا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و بەڕاستی بۆیان لە ڕۆژی زیاده‌دا ژوانێک هەیە"
    },
    {
      "lineIndex": 51,
      "startMs": 219755,
      "endMs": 223545,
      "ar": "زيادة زلفى غيرهم لا ينالـــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "زیاده‌ی نزیکی کە کەسانی تر بەدەستی ناهێنن"
    },
    {
      "lineIndex": 52,
      "startMs": 223545,
      "endMs": 227795,
      "ar": "•وجوه إلى وجه الإله نواظـــــر",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "دەم و چاوگەلێک کە بەرەو ڕوخساری خودا دەڕوانن"
    },
    {
      "lineIndex": 53,
      "startMs": 227795,
      "endMs": 231899,
      "ar": "لقد طال ما بالدمع كان ابتلالــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "کە مێژوویەکی درێژ بوو بە فرمێسک تەڕ دەبوون"
    },
    {
      "lineIndex": 54,
      "startMs": 231899,
      "endMs": 236302,
      "ar": "•تجلى لها الرب الرحيم مسلــــما",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "پەروەردگاری میهرەبان بۆیان دەردەکەوێت بە سەلامکردن"
    },
    {
      "lineIndex": 55,
      "startMs": 236302,
      "endMs": 240666,
      "ar": "فيزداد من ذاك التجلي جمالـــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئیتر لەو دەرکەوتنەوە جوانییەکەی زیاتر دەبێت"
    },
    {
      "lineIndex": 56,
      "startMs": 240666,
      "endMs": 244832,
      "ar": "•بمقعد صدق حبذا الجار ربهــــم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "لە جێگەیەکی ڕاستیدا، ئای چەند پەروەردگاریان دراوسێیەکی چاکە!"
    },
    {
      "lineIndex": 57,
      "startMs": 244832,
      "endMs": 248923,
      "ar": "ودار خلود لم يخافوا زوالــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ماڵی هەمیشەیی کە لەناوچوونی ناپڕووکێنن"
    },
    {
      "lineIndex": 58,
      "startMs": 248923,
      "endMs": 253176,
      "ar": "•فواكهها مما تلذ عيونهــــــــــم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "میوەکانی لەوانەن کە چاوەکانیان چێژی لێ وەردەگرێت"
    },
    {
      "lineIndex": 59,
      "startMs": 253176,
      "endMs": 257456,
      "ar": "وتطرد الأنهار بين خلالــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ڕووبارەکان لە نێوانیاندا دەڕژێن"
    },
    {
      "lineIndex": 60,
      "startMs": 257456,
      "endMs": 261772,
      "ar": "•على سرر موضونة ثم فرشهـــم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "لە سەربانی چێنراو، پاشان ڕاخەرەکانیان"
    },
    {
      "lineIndex": 61,
      "startMs": 261772,
      "endMs": 266122,
      "ar": "كما قال فيها ربنا واصفا لــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "وەک چۆن پەروەردگارمان وەصفی کردووە"
    },
    {
      "lineIndex": 62,
      "startMs": 266122,
      "endMs": 270071,
      "ar": "•بطائنها إستبرق كيف ظنــــــــكم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ناوپۆشەکەی لە ئەستەبرەقە، گومانتان چۆنە"
    },
    {
      "lineIndex": 63,
      "startMs": 270071,
      "endMs": 274365,
      "ar": "ظواهرها لا منتهى لجمالـــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بەڕووی دەرەوەی کە کۆتایی بۆ جوانییەکەی نییە!"
    },
    {
      "lineIndex": 64,
      "startMs": 274365,
      "endMs": 278484,
      "ar": "•وإن تكن الأخرى فويل وحسرة",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ئەگەر ئەویتریان بێت، ئەوا وەی و مەخابن"
    },
    {
      "lineIndex": 65,
      "startMs": 278484,
      "endMs": 282974,
      "ar": "ونار جحيم نا أشد نكالـــــــــــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "و ئاگری دۆزەخ کە چەند سەختە سزاکەی!"
    },
    {
      "lineIndex": 66,
      "startMs": 282974,
      "endMs": 287007,
      "ar": "•لهم تحتهم منها مهاد و فوقــهم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بۆیان لە ژێریانەوە بسترێک هەیە و لە سەروویانەوە"
    },
    {
      "lineIndex": 67,
      "startMs": 287007,
      "endMs": 291241,
      "ar": "غواش ومن يحموم ساء ظلالــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "پۆشەرێک، و لە دووکەڵی ڕەش کە خراپترین سێبەرە"
    },
    {
      "lineIndex": 68,
      "startMs": 291241,
      "endMs": 295527,
      "ar": "•طعامهم الغسلين وإن سقــــوا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "خواردنیان غسلینە و ئەگەر ئاویان پێ بپێورێت"
    },
    {
      "lineIndex": 69,
      "startMs": 295527,
      "endMs": 299969,
      "ar": "حميما به الأمعاء كان انحلالـــــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "لە ئاوی گەرم، ڕیخۆڵەکانیانی پێ دەتوێتەوە"
    },
    {
      "lineIndex": 70,
      "startMs": 299969,
      "endMs": 303772,
      "ar": "•أمانيهم فيها الهلاك وما لـــهم",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "ئاواتەکانیان لەوێدا لەناوچوونە و بۆیان نییە"
    },
    {
      "lineIndex": 71,
      "startMs": 303772,
      "endMs": 308163,
      "ar": "خروج ولا موت كما لا فنا لـــــها",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "دەرچوون و نە مردن، وەکو چۆن لەناوچوونی نییە"
    },
    {
      "lineIndex": 72,
      "startMs": 308163,
      "endMs": 312443,
      "ar": "•محلين قل للنفس ليس سواهما",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "دوو شوێنن، بە نەفس بڵێ جگە لەوانی تر نییە"
    },
    {
      "lineIndex": 73,
      "startMs": 312443,
      "endMs": 316572,
      "ar": "لتكسب أو فلتكتسب ما بدا لهـــــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "بۆ ئەوەی دەستی بکەوێت یان با ئەوەی بۆی دەردەکەوێت بەدەستی بهێنێت"
    },
    {
      "lineIndex": 74,
      "startMs": 316572,
      "endMs": 320795,
      "ar": "•فطوبى لنفس جوزت وتخففت",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "خۆزگە بەو نەفسەی بەسەردا تێپەڕی و باری سووک کرد"
    },
    {
      "lineIndex": 75,
      "startMs": 320795,
      "endMs": 326457,
      "ar": "فتنجو كفافا لا عليها ولا لهــــــا",
      "en": "",
      "fr": "",
      "ru": "",
      "de": "",
      "id": "",
      "nl": "",
      "ckb": "تا ڕزگاری بێت بە بێ قازانج و زیان، نە لەسەری بێت و نە بۆی بێت"
    }
  ]
}
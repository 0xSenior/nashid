    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 3967,
      "ar": "أماماً أماماً",
      "en": "Forward, forward!",
      "fr": "En avant, en avant !",
      "ru": "Вперед, вперед!",
      "de": "Vorwärts, vorwärts!",
      "id": "Maju, maju!",
      "nl": "Voorwaarts, voorwaarts!",
      "ckb": "بەرەو پێش، بەرەو پێش!"
    },
    {
      "lineIndex": 1,
      "startMs": 3967,
      "endMs": 5910,
      "ar": "سراعا جميعا",
      "en": "Swiftly, all together!",
      "fr": "Promptement, tous ensemble !",
      "ru": "Быстро, все вместе!",
      "de": "Zügig, alle zusammen!",
      "id": "Cepat, bersama-sama!",
      "nl": "Snel, met z'n allen!",
      "ckb": "بە خێرایی، هەموومان پێکەوە!"
    },
    {
      "lineIndex": 2,
      "startMs": 5910,
      "endMs": 8030,
      "ar": "يناصر لدينن",
      "en": "Supporting our religion,",
      "fr": "Pour soutenir notre religion,",
      "ru": "На защиту нашей религии,",
      "de": "Zur Unterstützung unserer Religion,",
      "id": "Membela agama kita,",
      "nl": "Ter ondersteuning van onze godsdienst,",
      "ckb": "بۆ پشتگیریی ئاینەکەمان،"
    },
    {
      "lineIndex": 3,
      "startMs": 8030,
      "endMs": 10247,
      "ar": "بدرب الجهاد",
      "en": "On the path of jihad.",
      "fr": "Sur le chemin du djihad.",
      "ru": "На пути джихада.",
      "de": "Auf dem Pfad des Dschihad.",
      "id": "Di jalan jihad.",
      "nl": "Op het pad van de djihad.",
      "ckb": "لە ڕێگای جیهاددا."
    },
    {
      "lineIndex": 4,
      "startMs": 10247,
      "endMs": 12314,
      "ar": "نبايع إما من",
      "en": "We pledge allegiance to a leader,",
      "fr": "Nous prêtons serment à un guide,",
      "ru": "Мы присягаем лидеру,",
      "de": "Wir leisten einem Anführer den Treueeid,",
      "id": "Kami berjanji setia kepada seorang pemimpin,",
      "nl": "Wij zweren trouw aan een leider,",
      "ckb": "بەڵێن و بەيعەت بە پێشەوایەک دەدەین،"
    },
    {
      "lineIndex": 5,
      "startMs": 12314,
      "endMs": 14450,
      "ar": "شيخا أما من",
      "en": "A noble elder leading us,",
      "fr": "Un noble cheikh à notre tête,",
      "ru": "Благородному шейху впереди,",
      "de": "Einem edlen Scheich an der Spitze,",
      "id": "Seorang syaikh mulia di depan,",
      "nl": "Een edele sjeik aan het hoofd,",
      "ckb": "شێخێکی بەڕێز لە پێشەوە،"
    },
    {
      "lineIndex": 6,
      "startMs": 14450,
      "endMs": 17233,
      "ar": "رَصُّوا الصُّفُوفَ",
      "en": "Close the ranks!",
      "fr": "Serrez les rangs !",
      "ru": "Сплотите ряды!",
      "de": "Schließt die Reihen!",
      "id": "Rapatkan barisan!",
      "nl": "Sluit de reeksen!",
      "ckb": "ڕیزەکانتان ڕێکبخەن!"
    },
    {
      "lineIndex": 7,
      "startMs": 17233,
      "endMs": 19102,
      "ar": "بيوم جيلد",
      "en": "On the day of struggle!",
      "fr": "Au jour du combat !",
      "ru": "В день битвы!",
      "de": "Am Tag des Kampfes!",
      "id": "Di hari pertempuran!",
      "nl": "Op de dag van de strijd!",
      "ckb": "لە ڕۆژی جەنگ و خەباتدا!"

  ],
  "lines": [
    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 9954,
      "ar": "كَمْ ذَا التَّلَاعُبُ مِنْكُمُو بِالدِّينِ وَالْـ"
    },
    {
      "lineIndex": 1,
      "startMs": 9954,
      "endMs": 12827,
      "ar": "إِيمَانِ مِثْلَ تَلَاعُبِ الصِّبْيَانِ"
    },
    {
      "lineIndex": 2,
      "startMs": 12827,
      "endMs": 16093,
      "ar": "خُسِفَتْ قُلُوبُكُمُ كَمَا كُسِفَتْ عُقُوـ"
    },
    {
      "lineIndex": 3,
      "startMs": 16093,
      "endMs": 19044,
      "ar": "لُكُمُو فَلَا تُزْكِي عَلَى القُرْآنِ"
    },
    {
      "lineIndex": 4,
      "startMs": 19044,
      "endMs": 22284,
      "ar": "كَمْ ذَا تَقُولُ مُجْمَلٌ وَمُؤَوَّلٌ"
    },
    {
      "lineIndex": 5,
      "startMs": 22284,
      "endMs": 25053,
      "ar": "وَظَوَاهِرٌ عُزِلَتْ عَنِ الإِيقَانِ"
    },
    {
      "lineIndex": 6,
      "startMs": 25053,
      "endMs": 28396,
      "ar": "حَتَّى إِذَا رَأْيُ الرِّجَالِ أَتَاكُمُ"
    },
    {
      "lineIndex": 7,
      "startMs": 28396,
      "endMs": 31296,
      "ar": "فَاسْمَعْ لِمَا يُوحَى بِلَا بُرْهَانِ"
    },
    {
      "lineIndex": 8,
      "startMs": 31296,
      "endMs": 34274,
      "ar": "مِثْلَ الخَفَافِيشِ الَّتِي إِنْ جَاءَهَا"
    },
    {
      "lineIndex": 9,
      "startMs": 34274,
      "endMs": 37304,
      "ar": "ضَوْءُ النَّهَارِ فَفِي كُوَى الحِيطَانِ"
    },
    {
      "lineIndex": 10,
      "startMs": 37304,
      "endMs": 40674,
      "ar": "عَمِيَتْ عَنِ الشَّمْسِ المُنِيرَةِ لَا تُطِيـ"
    },
    {
      "lineIndex": 11,
      "startMs": 40674,
      "endMs": 43364,
      "ar": "ـقُ هِدَايَةً فِيهَا إِلَى الطَّيَرَانِ"
    },
    {
      "lineIndex": 12,
      "startMs": 43364,
      "endMs": 46551,
      "ar": "حَتَّى إِذَا مَا اللَّيْلُ جَاءَ ظَلَامُهُ"
    },
    {
      "lineIndex": 13,
      "startMs": 46551,
      "endMs": 49137,
      "ar": "جَالَتْ بِظُلْمَتِهِ بِكُلِّ مَكَانِ"
    },
    {
      "lineIndex": 14,
      "startMs": 49137,
      "endMs": 52507,
      "ar": "فَتَرَى المَوَحِّدَ حِينَ يَسْمَعُ قَوْلَهُمْ"
    },
    {
      "lineIndex": 15,
      "startMs": 52507,
      "endMs": 55250,
      "ar": "وَيَرَاهُمُو فِي مِحْنَةٍ وَهَوَانِ"
    },
    {
      "lineIndex": 16,
      "startMs": 55250,
      "endMs": 58254,
      "ar": "وَرَحْمَتَاهُ لِعَيْنِهِ وَلِأُذْنِهِ"
    },
    {
      "lineIndex": 17,
      "startMs": 58254,
      "endMs": 61337,
      "ar": "يَا مِحْنَةَ العَيْنَيْنِ وَالأُذُنَانِ"
    },
    {
      "lineIndex": 18,
      "startMs": 61337,
      "endMs": 64863,
      "ar": "إِنْ قَالَ حَقًّا كَفَّرُوهُ وَإِنْ يَقُوـ"
    },
    {
      "lineIndex": 19,
      "startMs": 64863,
      "endMs": 67501,
      "ar": "ـلُوا بَاطِلًا نَسَبُوهُ لِلإِيمَانِ"
    },
    {
      "lineIndex": 20,
      "startMs": 67501,
      "endMs": 70767,
      "ar": "حَتَّى إِذَا مَا رَدَّهُ عَادَوْهُ مِـ"
    },
    {
      "lineIndex": 21,
      "startMs": 70767,
      "endMs": 73588,
      "ar": "ـثْلَ عَدَاوَةِ الشَّيْطَانِ لِلإِنْسَانِ"
    },
    {
      "lineIndex": 22,
      "startMs": 73588,
      "endMs": 76566,
      "ar": "قَالُوا لَهُ خَالَفْتَ أَقْوَالَ الشُّيُوـ"
    },
    {
      "lineIndex": 23,
      "startMs": 76566,
      "endMs": 79230,
      "ar": "ـخِ وَلَمْ يُبَالُوا الخُلْفَ لِلقُرْآنِ"
    },
    {
      "lineIndex": 24,
      "startMs": 79230,
      "endMs": 81921,
      "ar": "خَالَفْتُ أَقْوَالَ الشُّيُوَخِ وَأَنْتُمُو"
    },
    {
      "lineIndex": 25,
      "startMs": 81921,
      "endMs": 85291,
      "ar": "خَالَفْتُمُو مَنْ جَاءَ بِالقُرْآنِ"
    },
    {
      "lineIndex": 26,
      "startMs": 85291,
      "endMs": 88321,
      "ar": "خَالَفْتُمُو قَوْلَ الرَّسُولِ وَإِنَّمَا"
    },
    {
      "lineIndex": 27,
      "startMs": 88321,
      "endMs": 91377,
      "ar": "خَالَفْتُ مِنْ جَرَّاهُ قَوْلَ فُلَانِ"
    },
    {
      "lineIndex": 28,
      "startMs": 91377,
      "endMs": 94434,
      "ar": "يَا حَبَّذَا ذَاكَ الخِلَافُ فَإِنَّهُ"
    },
    {
      "lineIndex": 29,
      "startMs": 94434,
      "endMs": 97359,
      "ar": "عَيْنُ الوِفَاقِ لِطَاعَةِ الرَّحْمَنِ"
    },
    {
      "lineIndex": 30,
      "startMs": 97359,
      "endMs": 100416,
      "ar": "أَوَمَا عَلِمْتَ بِأَنَّ أَعْدَاءَ الرَّسُوـ"
    },
    {
      "lineIndex": 31,
      "startMs": 100416,
      "endMs": 103289,
      "ar": "ـلِ عَلَيْهِ عَابُوا الخُلْفَ بِالبُهْتَانِ"
    },
    {
      "lineIndex": 32,
      "startMs": 103289,
      "endMs": 106424,
      "ar": "لِشُيُوخِهِمْ وَلِمَا عَلَيْهِ قَدْ مَضَى"
    },
    {
      "lineIndex": 33,
      "startMs": 106424,
      "endMs": 109297,
      "ar": "أَسْلَافُهُمْ فِي سَالِفِ الأَزْمَانِ"
    },
    {
      "lineIndex": 34,
      "startMs": 109297,
      "endMs": 112301,
      "ar": "مَا العَيْبُ إِلَّا فِي خِلَافِ النَّصِّ لَا"
    },
    {
      "lineIndex": 35,
      "startMs": 112301,
      "endMs": 114966,
      "ar": "رَأْيِ الرِّجَالِ وَفِكْرَةِ الأَذْهَانِ"
    },
    {
      "lineIndex": 36,
      "startMs": 114966,
      "endMs": 118336,
      "ar": "أَنْتُمْ تُعِيبُونَا بِهَذَا وَهُوَ مِنْ"
    },
    {
      "lineIndex": 37,
      "startMs": 118336,
      "endMs": 121026,
      "ar": "تَوْفِيقِنَا وَالفَضْلُ لِلْمَنَّانِ"
    },
    {
      "lineIndex": 38,
      "startMs": 121026,
      "endMs": 124161,
      "ar": "فَلْيَهْنِكُمْ خُلْفُ النُُّصُوصِ وَيَهْنِنَا"
    },
    {
      "lineIndex": 39,
      "startMs": 124161,
      "endMs": 127217,
      "ar": "خُلْفُ الشُّيُوَخِ أَيَسْتَوِي الخُلْفَانِ"
    },
    {
      "lineIndex": 40,
      "startMs": 127217,
      "endMs": 130195,
      "ar": "وَاللهِ مَا تَسْوَى عُقُولُ جَمِيعِ أَهْـ"
    },
    {
      "lineIndex": 41,
      "startMs": 130195,
      "endMs": 132912,
      "ar": "ـلِ الأَرْضِ نَصًّا صَحَّ ذَا تِبْيَانِ"
    },
    {
      "lineIndex": 42,
      "startMs": 132912,
      "endMs": 136073,
      "ar": "حَتَّى نُقَدِّمَهَا عَلَيْهِ مُعْرِضِيـ"
    },
    {
      "lineIndex": 43,
      "startMs": 136073,
      "endMs": 139051,
      "ar": "ـنَ مُؤَوِّلِينَ مُحَرِّفِي القُرْآنِ"
    },
    {
      "lineIndex": 44,
      "startMs": 139051,
      "endMs": 141898,
      "ar": "وَاللهِ إِنَّ النَّصَّ فِيمَا بَيْنَنَا"
    },
    {
      "lineIndex": 45,
      "startMs": 141898,
      "endMs": 144563,
      "ar": "لَأَجَلُّ قَدْرًا يَا أُولِي الطُّغْيَانِ"
    },
    {
      "lineIndex": 46,
      "startMs": 144563,
      "endMs": 147828,
      "ar": "وَاللهِ لَمْ يَنْقِمْ عَلَيْنَا مِنْكُمُو"
    },
    {
      "lineIndex": 47,
      "startMs": 147828,
      "endMs": 150675,
      "ar": "أَبَدًا خِلَافَ النَّصِّ مِنْ إِنْسَانِ"
    },
    {
      "lineIndex": 48,
      "startMs": 150675,
      "endMs": 153392,
      "ar": "لَكِنْ خِلَافَ الأَشْعَرِيِّ بِزَعْمِكُمْ"
    },
    {
      "lineIndex": 49,
      "startMs": 153392,
      "endMs": 156344,
      "ar": "وَكَذَبْتُمُو وَأَنْتُمْ عَلَى الإِنْسَانِ"
    },
    {
      "lineIndex": 50,
      "startMs": 156344,
      "endMs": 159426,
      "ar": "كَفَّرْتُمُوهُ مَنْ قَالَ مَا قَدْ قَالَهُ"
    },
    {
      "lineIndex": 51,
      "startMs": 159426,
      "endMs": 162091,
      "ar": "فِي كُتْبِهِ تَصْرِيحَ ذِي الإِيقَانِ"
    },
    {
      "lineIndex": 52,
      "startMs": 162091,
      "endMs": 164808,
      "ar": "هَذَا وَخَالَفْنَاهُ فِي القُرْآنِ مِـ"
    },
    {
      "lineIndex": 53,
      "startMs": 164808,
      "endMs": 167707,
      "ar": "ـثْلَ خِلَافِكُمْ فِي الفَوْقِ لِلرَّحْمَنِ"
    },
    {
      "lineIndex": 54,
      "startMs": 167707,
      "endMs": 170737,
      "ar": "فَالأَشْعَرِيُّ مُصَرِّحٌ بِالاسْتِوَاءِ"
    },
    {
      "lineIndex": 55,
      "startMs": 170737,
      "endMs": 173637,
      "ar": "وَبِالعُلُوِّ بِغَايَةِ التِّبْيَانِ"
    },
    {
      "lineIndex": 56,
      "startMs": 173637,
      "endMs": 176589,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِإِثْبَاتِ الأَصَاـ"
    },
    {
      "lineIndex": 57,
      "startMs": 176589,
      "endMs": 179306,
      "ar": "ـبِعِ مِثْلَ مَا قَدْ قَالَ ذُو البُرْهَانِ"
    },
    {
      "lineIndex": 58,
      "startMs": 179306,
      "endMs": 182257,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِإِثْبَاتِ اليَدَيْـ"
    },
    {
      "lineIndex": 59,
      "startMs": 182257,
      "endMs": 185209,
      "ar": "ـنِ وَوَجْهِ رَبِّ العَرْشِ بِالسُّلْطَانِ"
    },
    {
      "lineIndex": 60,
      "startMs": 185209,
      "endMs": 188187,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِأَنَّ لِرَبِّنَا"
    },
    {
      "lineIndex": 61,
      "startMs": 188187,
      "endMs": 190930,
      "ar": "سُبْحَانَهُ عَيْنَانِ نَاظِرَتَانِ"
    },
    {
      "lineIndex": 62,
      "startMs": 190930,
      "endMs": 193725,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِإِثْبَاتِ النُّزُوـ"
    },
    {
      "lineIndex": 63,
      "startMs": 193725,
      "endMs": 196625,
      "ar": "ـلِ لِرَبِّنَا نَحْوَ الرَّقِيعِ الدَّانِي"
    },
    {
      "lineIndex": 64,
      "startMs": 196625,
      "endMs": 199420,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِأَنَّ اللهَ يَوْـ"
    },
    {
      "lineIndex": 65,
      "startMs": 199420,
      "endMs": 202607,
      "ar": "ـمَ الحَشْرِ يُبْصِرُهُ أُولُو الإِيمَانِ"
    },
    {
      "lineIndex": 66,
      "startMs": 202607,
      "endMs": 205663,
      "ar": "جَهْرًا يَرَوْنَ اللهَ فَوْقَ سَمَائِهِ"
    },
    {
      "lineIndex": 67,
      "startMs": 205663,
      "endMs": 208589,
      "ar": "رُؤْيَا العِيَانِ كَمَا يُرَى القَمَرَانِ"
    },
    {
      "lineIndex": 68,
      "startMs": 208589,
      "endMs": 211593,
      "ar": "وَمُصَرِّحٌ أَيْضًا بِإِثْبَاتِ المَجِيـ"
    },
    {
      "lineIndex": 69,
      "startMs": 211593,
      "endMs": 214493,
      "ar": "ـءِ وَأَنَّهُ يَأْتِي بِلَا نُكْرَانِ"
    },
    {
      "lineIndex": 70,
      "startMs": 214493,
      "endMs": 217549,
      "ar": "وَمُصَرِّحٌ بِفَسَادِ قَوْلِ مُؤَوِّلٍ"
    },
    {
      "lineIndex": 71,
      "startMs": 217549,
      "endMs": 220318,
      "ar": "لِلاسْتِوَاءِ بِقَهْرِ ذِي السُّلْطَانِ"
    },
    {
      "lineIndex": 72,
      "startMs": 220318,
      "endMs": 222904,
      "ar": "وَمُصَرِّحٌ أَنَّ الأُولَى قَالُوا بِذَا"
    },
    {
      "lineIndex": 73,
      "startMs": 222904,
      "endMs": 225804,
      "ar": "التَّأْوِيلِ أَهْلُ ضَلَالَةٍ بِبَيَانِ"
    },
    {
      "lineIndex": 74,
      "startMs": 225804,
      "endMs": 228834,
      "ar": "وَمُصَرِّحٌ أَنَّ الَّذِي قَدْ قَالَهُ"
    },
    {
      "lineIndex": 75,
      "startMs": 228834,
      "endMs": 231707,
      "ar": "أَهْلُ الحَدِيثِ وَعَسْكَرُ القُرْآنِ"
    },
    {
      "lineIndex": 76,
      "startMs": 231707,
      "endMs": 234816,
      "ar": "هُوَ قَوْلُهُ يَلْقَى عَلَيْهِ رَبَّهُ"
    },
    {
      "lineIndex": 77,
      "startMs": 234816,
      "endMs": 237872,
      "ar": "وَبِهِ يَدِينُ اللهَ كُلَّ أَوَانِ"
    },
    {
      "lineIndex": 78,
      "startMs": 237872,
      "endMs": 241033,
      "ar": "لَكِنَّهُ قَدْ قَالَ إِنَّ كَلَامَهُ"
    },
    {
      "lineIndex": 79,
      "startMs": 241033,
      "endMs": 243776,
      "ar": "مَعْنًى يَقُومُ بِنَفْسِهِ بِبَيَانِ"
    },
    {
      "lineIndex": 80,
      "startMs": 243776,
      "endMs": 247119,
      "ar": "فِي القَوْلِ خَالَفْنَاهُ نَحْنُ وَأَنْتُمُ"
    },
    {
      "lineIndex": 81,
      "startMs": 247119,
      "endMs": 249941,
      "ar": "فِي الفَوْقِ فَأْتُوا الآنَ بِالبُرْهَانِ"
    },
    {
      "lineIndex": 82,
      "startMs": 249941,
      "endMs": 252971,
      "ar": "لِمْ كَانَ نَفْسُ خِلَافِنَا كُفْرًا وَكَاـ"
    },
    {
      "lineIndex": 83,
      "startMs": 252971,
      "endMs": 255870,
      "ar": "ـنَ خِلَافُكُمْ هُوَ مُقْتَضَى الإِيمَانِ"
    },
    {
      "lineIndex": 84,
      "startMs": 255870,
      "endMs": 258666,
      "ar": "هَذَا وَخَالَفْنَا لِنَصٍّ فِينَا خَاـ"
    },
    {
      "lineIndex": 85,
      "startMs": 258666,
      "endMs": 261722,
      "ar": "ـلَفْتُمْ لِرَأْيٍ لَا سَوَاءٌ ذَانِ"
    },
    {
      "lineIndex": 86,
      "startMs": 261722,
      "endMs": 264700,
      "ar": "وَاللهِ مَا لَكُمُ جَوَابٌ غَيْرُ تَكْـ"
    },
    {
      "lineIndex": 87,
      "startMs": 264700,
      "endMs": 267756,
      "ar": "ـفِيرٍ بِلَا عِلْمٍ وَلَا إِيقَانِ"
    },
    {
      "lineIndex": 88,
      "startMs": 267756,
      "endMs": 270469,
      "ar": "أَسْتَغْفِرُ اللهَ العَظِيمَ لَكُمْ جَوَﺍـ"
    },
    {
      "lineIndex": 89,
      "startMs": 270469,
      "endMs": 273168,
      "ar": "ـبٌ غَيْرُ ذِي الشَّكْوَى إِلَى السُّلْطَانِ"
    },
    {
      "lineIndex": 90,
      "startMs": 273168,
      "endMs": 276248,
      "ar": "فَهُوَ الجَوَابُ لَدَيْكُمُ وَلَنَا نَحْنُ مُـ"
    },
    {
      "lineIndex": 91,
      "startMs": 276248,
      "endMs": 278989,
      "ar": "ـتَّظِرُوهُ مِنْكُمْ يَا أُولِي البُرْهَانِ"
    },
    {
      "lineIndex": 92,
      "startMs": 278989,
      "endMs": 281738,
      "ar": "وَاللهِ لَا الأَشْعَرِيَّةَ تَبِعْتُمُو"
    },
    {
      "lineIndex": 93,
      "startMs": 281738,
      "endMs": 284368,
      "ar": "كَلَّا وَلَا لِلنَّصِّ بِالإِحْسَانِ"
    },
    {
      "lineIndex": 94,
      "startMs": 284368,
      "endMs": 287557,
      "ar": "يَا قَوْمِ فَانْتَبِهُوا لِأَنْفُسِكُمْ وَخَلْـ"
    },
    {
      "lineIndex": 95,
      "startMs": 287557,
      "endMs": 290338,
      "ar": "ـلُوا الجَهْلَ وَالدَّعْوَى بِلَا بُرْهَانِ"
    },
    {
      "lineIndex": 96,
      "startMs": 290338,
      "endMs": 293288,
      "ar": "مَا فِي الرِّيَاسَةِ بِالجَهَالَةِ غَيْرُ ضِحْـ"
    },
    {
      "lineIndex": 97,
      "startMs": 293288,
      "endMs": 296189,
      "ar": "ـكَةِ عَاقِلٍ مِنْكُمْ مَدَى الأَزْمَانِ"
    },
    {
      "lineIndex": 98,
      "startMs": 296189,
      "endMs": 299258,
      "ar": "لَا تَرْتَضُوا بِرِيَاسَةِ البَقَرِ الَّتِي"
    },
    {
      "lineIndex": 99,
      "startMs": 299258,
      "endMs": 302231,
      "ar": "رُؤَسَاؤُهَا مِنْ جُمْلَةِ الثِّيرَانِ"
    }
  ]
}
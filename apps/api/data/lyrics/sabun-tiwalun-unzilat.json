    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 4948,
      "ar": "سَبْعٌ طِوَالٌ أُنْزِلَتْ",
      "en": "Seven long surahs were revealed,",
      "fr": "Sept sourates longues ont été révélées",
      "ru": "Семь длинных сур были ниспосланы",
      "de": "Sieben lange Suren wurden herabgesandt",
      "id": "Tujuh surah panjang telah diturunkan",
      "nl": "Zeven lange soera's zijn geopenbaard",
      "ckb": "حەوت سوورەتە درێژەکە دا بەزێنران"
    },
    {
      "lineIndex": 1,
      "startMs": 4948,
      "endMs": 7258,
      "ar": "مِنْ رَبِّنَا وَرُتِّلَتْ",
      "en": "Sent by our Lord and recited.",
      "fr": "De notre Seigneur et récitées",
      "ru": "От нашего Господа и размеренно прочитаны",
      "de": "Von unserem Herrn und rezitiert",
      "id": "Dari Tuhan kita dan dilantunkan",
      "nl": "Van onze Heer en gereciteerd",
      "ckb": "لە پەروەردگارمانەوە و خوێندرانەوە"
    },
    {
      "lineIndex": 2,
      "startMs": 7258,
      "endMs": 9767,
      "ar": "أَوَّلُهُنَّ الْبَقَرَةُ",
      "en": "The first of them is Al-Baqarah,",
      "fr": "La première d'entre elles est Al-Baqarah",
      "ru": "Первая из них — «Аль-Бакара»",
      "de": "Die erste von ihnen ist Al-Baqarah",
      "id": "Yang pertama adalah Al-Baqarah",
      "nl": "De eerste daarvan is Al-Baqarah",
      "ckb": "یەکەمیان سوورەتی بەقەرەیە"
    },
    {
      "lineIndex": 3,
      "startMs": 9767,
      "endMs": 12078,
      "ar": "طَارِدَةٌ لِلسَّحَرَةِ",
      "en": "A surah that drives away sorcerers.",
      "fr": "Qui chasse les sorciers",
      "ru": "Прогоняющая колдунов",
      "de": "Die die Zauberer vertreibt",
      "id": "Pengusir para penyihir",
      "nl": "Die tovenaars verjaagt",
      "ckb": "دەرکەر و دوورخەرەوەی جادووگەرانە"
    },
    {
      "lineIndex": 4,
      "startMs": 12078,
      "endMs": 14366,
      "ar": "مَوْضُوعُهَا النِّفَاقُ",
      "en": "Its subjects include hypocrisy,",
      "fr": "Ses thèmes sont l'hypocrisie",
      "ru": "Её темы — лицемерие",
      "de": "Ihre Themen sind Heuchelei",
      "id": "Temanya adalah kemunafikan",
      "nl": "Het thema ervan is huichelarij",
      "ckb": "بابەتەکەی دووڕووییە"
    },
    {
      "lineIndex": 5,
      "startMs": 14366,
      "endMs": 16919,
      "ar": "وَالصَّوْمُ وَالطَّلَاقُ",
      "en": "Fasting and divorce.",
      "fr": "Le jeûne et le divorce",
      "ru": "Пост и развод",
      "de": "Das Fasten und die Scheidung",
      "id": "Puasa dan perceraian",
      "nl": "Het vasten en de echtscheiding",
      "ckb": "وە ڕۆژوو و طەڵاقە"
    },
    {
      "lineIndex": 6,
      "startMs": 16919,
      "endMs": 19274,
      "ar": "رَتِّلْ سُطُورَ آلِ",
      "en": "Recite the verses of Āl",
      "fr": "Récite les versets d'Al-",
      "ru": "Читай строки суры «Али",
      "de": "Rezitiere die Zeilen von Al-",
      "id": "Lantunkanlah bait-bait Ali",
      "nl": "Reciteer de regels van Al-",
      "ckb": "بێژەی دێڕەکانی ئالی"
    },
    {
      "lineIndex": 7,
      "startMs": 19274,
      "endMs": 21704,
      "ar": "عِمْرَانَ، فَهْيَ التَّالِي",
      "en": "ʿImrān, for it comes next.",
      "fr": "Imran, car c'est la suivante",
      "ru": "Имран», ведь она следующая",
      "de": "Imran, denn sie ist die nächste",
      "id": "Imran, karena ia adalah berikutnya",
      "nl": "Imran, want dat is de volgende",
      "ckb": "عیمران بکە، چونکە ئەوەی دوایەتی"
    },
    {
      "lineIndex": 8,
      "startMs": 21704,
      "endMs": 24180,
      "ar": "اقْرَأْ تَرَ غَزْوَةَ أُحُدْ",
      "en": "Read, and you will find the Battle of Uḥud,",
      "fr": "Lis, tu y verras la bataille d'Uhud",
      "ru": "Прочти, и увидишь битву при Ухуде",
      "de": "Lies, du wirst die Schlacht von Uhud sehen",
      "id": "Bacalah, engkau akan melihat Perang Uhud",
      "nl": "Lees, je zult de Slag bij Uhud zien",
      "ckb": "بپشکنە تا جەنگی ئوحود ببینی"
    },
    {
      "lineIndex": 9,
      "startMs": 24180,
      "endMs": 26389,
      "ar": "فِيهَا وَحَمْرَاءَ الْأَسَدْ",
      "en": "And the expedition of Ḥamrāʾ al-Asad.",
      "fr": "Et celle de Hamra Al-Asad",

      "nl": "Het zuiverde de Maagd",
      "ckb": "مریەمی کچێنی بێبەری کرد"
    },
    {
      "lineIndex": 12,
      "startMs": 31345,
      "endMs": 33489,
      "ar": "وَلِلْفُرُوضِ قَاسِمَةْ",

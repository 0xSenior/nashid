      "id": "Kemudian bacalah An-Nisa",
      "nl": "Lees daarna An-Nisa",
      "ckb": "پاشان سوورەتی نیسا بخوێنەوە"
    },
    {
      "lineIndex": 11,
      "startMs": 28947,
      "endMs": 31345,
      "ar": "بَرَّأَتِ الْعَذْرَاءَ",
      "en": "Which declared the innocent woman free of blame.",
      "fr": "Elle a innocenté la Vierge",
      "ru": "Она оправдала Девственницу",
      "de": "Sie hat die Jungfrau freigesprochen",

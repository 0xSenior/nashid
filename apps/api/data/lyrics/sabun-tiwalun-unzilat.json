      "nl": "En daarna komt Al-Ma'idah",
      "ckb": "وە لە دوای ئەوان سوورەتی مائیدەیە"
    },
    {
      "lineIndex": 15,
      "startMs": 38468,
      "endMs": 40714,
      "ar": "بِصِدْقِ عِيسَى شَاهِدَةْ",

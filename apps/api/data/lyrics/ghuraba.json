    {
      "lineIndex": 4,
      "startMs": 30371,
      "endMs": 39252,
      "ar": "غُرَبَاءُ وَلِغَيْرِ اللَّهِ لاَ نَحْنِي الْجِبَاه",
      "en": "Strangers, and to none but Allah do we bow our heads",
      "fr": "Étrangers, et devant nul autre qu'Allah nous ne courbons le front",
      "ru": "Чужаки, и ни перед кем, кроме Аллаха, мы не склоняем голов",
      "de": "Fremde, und vor niemandem außer Allah beugen wir die Stirn",
      "id": "Orang asing, dan hanya kepada Allah kami menundukkan dahi",
      "nl": "Vreemdelingen, en voor niemand behalve Allah buigen wij ons voorhoofd",
      "ckb": "غەریبین و بۆ جگە لە ئەڵڵاه سەر دانانوێنین"
    },
    {
      "lineIndex": 5,
      "startMs": 39252,
      "endMs": 48910,
      "ar": "غُرَبَاءُ وَارْتَضَيْنَاهَا شِعَاراً لِلْحَيَاة",
      "en": "Strangers, and we have chosen it as a motto for life",
      "fr": "Étrangers, et nous en avons fait notre devise pour la vie",
      "ru": "Чужаки, и мы избрали это девизом жизни",
      "de": "Fremde, und wir haben es als Lebensmotto gewählt",
      "id": "Orang asing, dan kami telah memilihnya sebagai semboyan hidup",
      "nl": "Vreemdelingen, en wij hebben dit aanvaard als motto voor het leven",
      "ckb": "غەریبین و ئەمەمان وەک دروشمی ژیان هەڵبژاردووە"
    },
    {
      "lineIndex": 6,
      "startMs": 48910,
      "endMs": 58630,
      "ar": "إِنْ تَسَلْ عَنَّا فَإِنَّا لاَ نُبَالِي بِالطُّغَاة",
      "en": "If you ask about us, we do not care about tyrants",
      "fr": "Si tu t'interroges sur nous, nous ne soucions guère des tyrans",
      "ru": "Если спросишь о нас, то нам нет дела до тиранов",
      "de": "Wenn du nach uns fragst, kümmern uns die Tyrannen nicht",
      "id": "Jika engkau bertanya tentang kami, kami tidak peduli pada para thagut",
      "nl": "Als je naar ons vraagt, geven wij niet om tirannen",
      "ckb": "ئەگەر پرسیار لەبارەی ئێمەوە بکەیت، گوێ بە ستەمکاران نادەین"
    },
    {
      "lineIndex": 7,
      "startMs": 58630,
      "endMs": 67344,
      "ar": "نَحْنُ جُنْدُ اللَّهِ دَوْماً دَرْبُنَا دَرْبُ الأُبَاة",
      "en": "We are the soldiers of Allah always, our path is the path of the proud",
      "fr": "Nous sommes les soldats d'Allah pour toujours, notre voie est celle des hommes dignes",
      "ru": "Мы воины Аллаха всегда, наш путь — путь гордых и непокорных",
      "de": "Wir sind die Soldaten Allahs für immer, unser Weg ist der Weg der Stolzen",
      "id": "Kami adalah prajurit Allah selamanya, jalan kami adalah jalan orang-orang yang teguh",
      "nl": "Wij zijn altijd de soldaten van Allah, ons pad is het pad van de standvastigen",
      "ckb": "ئێمە هەمیشە سەربازی خدائین و ڕێگامان ڕێگای کەسانی سەربەرزە"
    },

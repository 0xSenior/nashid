      "ckb": "ئەی کەسوکارمان لە گەڕەک",
      "fa": "ای همسایه‌ها و اهالی محله ما"
    },
    {
      "lineIndex": 79,
      "startMs": 258443,
      "endMs": 260781,
      "ar": "لاَبُدَّ نِفْهَمْ شَيْ",

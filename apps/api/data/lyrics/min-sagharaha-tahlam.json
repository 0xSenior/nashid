  "lines": [
    {
      "lineIndex": 0,
      "startMs": 0,
      "endMs": 6200,
      "ar": "﴿الْمَالُ وَالْبَنُونَ زِينَةُ الْحَيَاةِ الدُّنْيَا",
      "en": "Wealth and children are the adornment of the life of this world",
      "fr": "Les biens et les enfants sont la parure de la vie d'ici-bas",
      "ru": "Богатство и сыновья — украшение мирской жизни",
      "de": "Besitz und Kinder sind der Schmuck des weltlichen Lebens",
      "id": "Harta dan anak-anak adalah perhiasan kehidupan dunia",
      "nl": "Bezit en kinderen zijn de versiering van het wereldse leven",
      "ckb": "سامان و منداڵان ڕازاوەیی ژیانی دونیان",
      "fa": "«مال و فرزندان، زینت زندگی دنیا هستند؛"
    },
    {
      "lineIndex": 1,
      "startMs": 6200,
      "endMs": 13360,
      "ar": "وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا",
      "en": "And the enduring good deeds are better to your Lord for reward",
      "fr": "Cependant, les œuvres pieuses et durables sont meilleures auprès de ton Seigneur comme récompense",
      "ru": "А сохранившиеся праведные деяния лучше перед твоим Господом по награде",
      "de": "Die bleibenden guten Werke aber sind besser bei deinem Herrn als Belohnung",
      "id": "Tetapi amalan-amalan yang kekal lagi saleh adalah lebih baik pahalanya di sisi Tuhanmu",
      "nl": "Maar de blijvende goede daden zijn beter bij jouw Heer als beloning",
      "ckb": "و کارە چاکە بەردەوامەکان لەلای پەروەردگارت باشترن لە ڕووی پاداشتەوە",
      "fa": "و نیکی‌های ماندگار نزد پروردگارت پاداشی بهتر"
    },
    {
      "lineIndex": 2,
      "startMs": 13360,
      "endMs": 18251,
      "ar": "خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا",
      "en": "better to your Lord for reward",
      "fr": "meilleures auprès de ton Seigneur comme récompense",
      "ru": "лучше перед твоим Господом по награде",
      "de": "besser bei deinem Herrn als Belohnung",
      "id": "lebih baik pahalanya di sisi Tuhanmu",
      "nl": "beter bij jouw Heer als beloning",
      "ckb": "باشترن لە ڕووی پاداشتەوە",
      "fa": "نزد پروردگارت پاداشی بهتر"
    },
    {
      "lineIndex": 3,
      "startMs": 18251,
      "endMs": 23480,
      "ar": "وَخَيْرٌ أَمَلًا﴾۝٤٦[سُورَةُ الْكَهْفِ]",
      "en": "and better for hope [Surah Al-Kahf: 46]",
      "fr": "et meilleures en tant qu'espoir [Sourate Al-Kahf: 46]",
      "ru": "и лучше по надежде [Сура Аль-Кахф: 46]",
      "de": "und besser an Hoffnung [Sure Al-Kahf: 46]",
      "id": "dan lebih baik untuk menjadi harapan [Surah Al-Kahf: 46]",
      "nl": "en beter als hoop [Soera Al-Kahf: 46]",
      "ckb": "و باشترن بۆ ئاوات و ئومێد [سوورەتی کەهف: ٤٦]",
      "fa": "و امیدی بهتر دارند.» [سوره کهف: ۴۶]"
    },
    {
      "lineIndex": 4,
      "startMs": 23480,
      "endMs": 26061,
      "ar": "خُذُوا شَهَادَتَهَا",
      "en": "Take her degree",
      "fr": "Prenez son diplôme",
      "ru": "Заберите её диплом",
      "de": "Nehmt ihr Diplom",
      "id": "Ambillah ijazahnya",
      "nl": "Neem haar diploma",
      "ckb": "بڕوانامەکەی لێ بسێنن",
      "fa": "مدرک‌های تحصیلی‌اش را بگیرید"
    },
    {
      "lineIndex": 5,
      "startMs": 26061,
      "endMs": 28451,
      "ar": "خُذُوا قُصُورَهَا",
      "en": "Take her mansions",
      "fr": "Prenez ses palais",
      "ru": "Заберите её дворцы",
      "de": "Nehmt ihre Paläste",
      "id": "Ambillah istananya",
      "nl": "Neem haar paleizen",
      "ckb": "کۆشکەکانی لێ بسێنن",
      "fa": "کاخ‌هایش را بگیرید"
    },
    {
      "lineIndex": 6,
      "startMs": 28451,
      "endMs": 30952,
      "ar": "خُذُوا دِرْهَمَهَا وَدِينَارَهَا",
      "en": "Take her dirhams and dinars",
      "fr": "Prenez ses dirhams et ses dinars",
      "ru": "Заберите её дирхамы и динары",
      "de": "Nehmt ihre Dirhams und Dinare",
      "id": "Ambillah dirham dan dinarnya",
      "nl": "Neem haar dirhams en dinars",
      "ckb": "دیرهەم و دینارەکەی لێ بسێنن",
      "fa": "درهم و دینارش را بگیرید"
    },
    {
      "lineIndex": 7,
      "startMs": 30952,
      "endMs": 33181,
      "ar": "خُذُوا مَا أَرَدْتُمْ",
      "en": "Take whatever you wish",
      "fr": "Prenez tout ce que vous voulez",
      "ru": "Заберите всё, что пожелаете",
      "de": "Nehmt, was immer ihr wollt",
      "id": "Ambillah apa pun yang kalian inginkan",
      "nl": "Neem wat jullie maar willen",
      "ckb": "ئەوەی دەتانەوێت بیبەن",
      "fa": "هر چه می‌خواهید بگیرید"
    },
    {
      "lineIndex": 8,
      "startMs": 33181,
      "endMs": 37803,
      "ar": "وَأَعْطُوهَا طِفْلًا يُنَادِيهَا",
      "en": "And give her a child who calls her",
      "fr": "Et donnez-lui un enfant qui l'appelle",
      "ru": "Но дайте ей ребёнка, который зовёт её",
      "de": "Und gebt ihr ein Kind, das sie ruft",
      "id": "Dan berikanlah padanya seorang anak yang memanggilnya",
      "nl": "En geef haar een kind dat haar roept",
      "ckb": "و منداڵێکی پێ ببەخشن کە بانگی بکات",
      "fa": "اما به او کودکی بدهید که صدا بزند:"
    },
    {
      "lineIndex": 9,
      "startMs": 37803,
      "endMs": 39093,
      "ar": "أُمَّاهْ",
      "en": "Mother!",
      "fr": "Maman !",
      "ru": "Мама!",
      "de": "Mama!",
      "id": "Ibu!",
      "nl": "Mama!",
      "ckb": "دایکە!",
      "fa": "«مادر!»"
    },
    {
      "lineIndex": 10,
      "startMs": 39093,
      "endMs": 42483,
      "ar": "مِنْ صِغَرَهَا تَحْلَمْ",
      "en": "From her youth she dreams",
      "fr": "Depuis son jeune âge elle rêve",
      "ru": "С самого детства она мечтает",
      "de": "Seit ihrer Jugend träumt sie",
      "id": "Sejak kecil dia bermimpi",
      "nl": "Sinds haar jeugd droomt ze",
      "ckb": "لە منداڵییەوە خەون دەبینێت",
      "fa": "از کودکی‌اش آرزو می‌کرد"
    },
    {
      "lineIndex": 11,
      "startMs": 42483,
      "endMs": 45032,
      "ar": "تَكْبَرْ وَتَصْبَحْ أُمّ",
      "en": "To grow up and become a mother",
      "fr": "De grandir et de devenir mère",
      "ru": "Вырасти и стать матерью",
      "de": "Erwachsen zu werden und Mutter zu sein",
      "id": "Tumbuh dewasa dan menjadi seorang ibu",
      "nl": "Om op te meoeien en moeder te worden",
      "ckb": "گەورە بێت و ببێتە دایک",
      "fa": "بزرگ شود و مادر گردد"
    },
    {
      "lineIndex": 12,
      "startMs": 45032,
      "endMs": 48432,
      "ar": "وَبِصَدْرِهَا الطَّاهِرْ",
      "en": "And against her pure chest",
      "fr": "Et contre sa poitrine pure",
      "ru": "И к своей чистой груди",
      "de": "Und an ihre reine Brust",
      "id": "Dan di dadanya yang suci",
      "nl": "En tegen haar zuivere borst",
      "ckb": "و بە سنگە پاکەکەیەوە",
      "fa": "و بر سینه پاکش"
    },
    {
      "lineIndex": 13,
      "startMs": 48432,
      "endMs": 51661,
      "ar": "تَضُمَّ دَمْيَتَهَا",
      "en": "She hugs her doll",
      "fr": "Elle serre sa poupée",
      "ru": "Она прижимает свою куклу",
      "de": "Drückt sie ihre Puppe",
      "id": "Dia melempar dekapan pada bonekanya",
      "nl": "Kust en omhelst ze haar pop",
      "ckb": "بووکەڵەکەی لەباوەش دەگرێت",
      "fa": "عروسکش را به آغوش فشارد"
    },
    {
      "lineIndex": 14,
      "startMs": 51661,
      "endMs": 54901,
      "ar": "وَتْقُولْ يَا حُبِّي",
      "en": "And says, 'O my love'",
      "fr": "Et dit : 'Ô mon amour'",
      "ru": "И говорит: 'О моя любовь'",
      "de": "Und sagt: 'O meine Liebe'",
      "id": "Dan berkata, 'Wahai cintaku'",
      "nl": "En zegt: 'O mijn liefde'",
      "ckb": "و دەڵێت: 'ئەی خۆشەویستم'",
      "fa": "و بگوید ای عشق من"
    },
    {
      "lineIndex": 15,
      "startMs": 54901,
      "endMs": 58173,
      "ar": "يَحْفَظْكِ لِي رَبِّي",
      "en": "May my Lord protect you for me",
      "fr": "Que mon Seigneur te protège pour moi",
      "ru": "Пусть мой Господь сохранит тебя для меня",
      "de": "Möge mein Herr dich für mich beschützen",
      "id": "Semoga Tuhanku menjagamu untukku",
      "nl": "Moge mijn Heer jou voor mij beschermen",
      "ckb": "پەروەردگارم بۆم بپارێزێت",
      "fa": "پروردگارم تو را برایم حفظ کند"
    },
    {
      "lineIndex": 16,
      "startMs": 58173,
      "endMs": 61483,
      "ar": "وَتْنَّوِّمَ الدَّمْيَة",
      "en": "And she puts the doll to sleep",
      "fr": "Et elle endort la poupée",
      "ru": "И укладывает куклу спать",
      "de": "Und sie legt die Puppe schlafen",
      "id": "Dan dia menidurkan boneka itu",
      "nl": "En ze legt de pop te slapen",
      "ckb": "و بووکەڵەکە دەخەوێنێت",
      "fa": "و عروسک را بخواباند"
    },
    {
      "lineIndex": 17,
      "startMs": 61483,
      "endMs": 64432,
      "ar": "عَلَى مَخَدَّتَهَا",
      "en": "On her pillow",
      "fr": "Sur son oreiller",
      "ru": "На свою подушку",
      "de": "Auf ihr Kissen",
      "id": "Di atas bantalnya",
      "nl": "Op haar kussen",
      "ckb": "لە سەر سەرینەکەی",
      "fa": "روی بالش خودش"
    },
    {
      "lineIndex": 18,
      "startMs": 64432,
      "endMs": 67672,
      "ar": "يَوْمٍ وَبَعْدَهْ يَوْمْ",
      "en": "Day after day",
      "fr": "Jour après jour",
      "ru": "День за днём",
      "de": "Tag für Tag",
      "id": "Hari demi hari",
      "nl": "Dag na dag",
      "ckb": "ڕۆژ دوای ڕۆژ",
      "fa": "روزی و پس از آن روزی دیگر"
    },
    {
      "lineIndex": 19,
      "startMs": 67672,
      "endMs": 70952,
      "ar": "وَالْحُلْمِ صَارْ حُلُومْ",
      "en": "And the dream grew into dreams",
      "fr": "Et le rêve est devenu des rêves",
      "ru": "И мечта превратилась в мечты",
      "de": "Und der Traum wurde zu Träumen",
      "id": "Dan mimpi itu menjadi kenyataan bermimpi",
      "nl": "En de droom werd dromen",
      "ckb": "و خەونەکە بووە خەونەکان",

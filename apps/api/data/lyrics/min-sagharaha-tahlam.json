      "nl": "Als schaamte en angst er niet waren",
      "ckb": "ئەگەر شەرم و ترس نەبووایە",
      "fa": "اگر حیا و ترس نبود"
    },
    {
      "lineIndex": 69,
      "startMs": 228693,
      "endMs": 231603,
      "ar": "صَاحَتْ عَلَى المَكْشُوف",

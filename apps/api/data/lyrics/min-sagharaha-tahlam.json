      "startMs": 166573,
      "endMs": 170373,
      "ar": "تِبْعِدْ عَنِ الأَنْظَارْ",
      "en": "She stays away from sight",
      "fr": "Elle s'éloigne des regards",
      "ru": "Она прячется от чужих глаз",
      "de": "Sie zieht sich von den Blicken zurück",
      "id": "Dia menjauh dari pandangan orang-orang",
      "nl": "Ze blijft uit het zicht",
      "ckb": "دوور دەکەوێتەوە لە چاوەکان",
      "fa": "از دیده‌ها دور می‌شود"
    },
    {
      "lineIndex": 51,
      "startMs": 170373,
      "endMs": 173563,
      "ar": "وَتْسَامِرِ الأَفْكَارْ",
      "en": "And converses with her thoughts",
      "fr": "Et converse avec ses pensées",
      "ru": "И ведет беседы со своими мыслями",
      "de": "Und verweilt in ihren Gedanken",
      "id": "Dan bermesraan dengan pikirannya",
      "nl": "En blijft alleen met haar gedachten",
      "ckb": "و لەگەڵ بیرۆکەکانیدا گفتوگۆ دەکات",
      "fa": "و با افکارش خلوت می‌کند"
    },
    {

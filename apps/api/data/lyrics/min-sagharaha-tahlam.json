      "startMs": 173563,
      "endMs": 176563,
      "ar": "حُلْمِ الأُمُومَة صَارْ",
      "en": "The dream of motherhood became",
      "fr": "Le rêve de la maternité est devenu",
      "ru": "Мечта о материнстве стала",
      "de": "Der Traum von der Mutterschaft wurde",
      "id": "Mimpi menjadi ibu telah menjadi",
      "nl": "De droom van moederschap werd",
      "ckb": "خەونی دایکایەتی بوو بە",
      "fa": "رویای مادری شد"
    },

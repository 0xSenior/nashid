    },
    {
      "lineIndex": 39,
      "startMs": 131152,
      "endMs": 134483,
      "ar": "وَتِعِيشْ أُنُوثَتَهَا",
      "en": "And lives her womanhood",
      "fr": "Et vit sa féminité",
      "ru": "И проживает свою женственность",

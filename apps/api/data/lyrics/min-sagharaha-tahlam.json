      "nl": "Op haar kussen",
      "ckb": "لە سەر سەرینەکەی",
      "fa": "روی بالش خودش"
    },
    {
      "lineIndex": 34,
      "startMs": 115413,
      "endMs": 118403,
      "ar": "ثُمَّ تِكْبَرْ الطَِّفْلَة",
      "en": "Then the girl grows up",
      "fr": "Puis la fillette grandit",
      "ru": "Затем девочка подрастает",
      "de": "Dann wächst das Mädchen heran",

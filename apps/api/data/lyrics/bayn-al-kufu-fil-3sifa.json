      "nl": "En de rust van de strijder",
      "ckb": "و حەسانەوەی موجاهید",
      "fa": "و آرامش مجاهد"
    },
    {
      "lineIndex": 21,
      "startMs": 64621,
      "endMs": 66400,
      "ar": "فِي سَاحَةِ المَسَاجِدِ",
      "en": "Is in the courtyard of the mosques",
      "fr": "Est dans l'enceinte des mosquées",
      "ru": "В дворах мечетей",
      "de": "Ist auf dem Hof der Moscheen",
      "id": "Ada di pelataran masjid-masjid",
      "nl": "Is op het plein van de moskeeën",
      "ckb": "لە گۆڕەپانی مزگەوتەکاندایە",
      "fa": "در صحن مساجد است"
    },
    {
      "lineIndex": 22,
      "startMs": 66400,
      "endMs": 68229,
      "ar": "فَالنَّاسُ فِي اصْطِفَافِهِمْ",
      "en": "For the people in their alignment",
      "fr": "Car les gens dans leurs rangs",
      "ru": "Ибо люди в своем строю",
      "de": "Denn die Menschen in ihren Reihen",
      "id": "Karena manusia dalam barisan mereka",
      "nl": "Want de mensen in hun gelederen",
      "ckb": "چونکە خەڵک لە وەستانیدا",
      "fa": "چرا که مردم در صف‌هایشان"
    },
    {
      "lineIndex": 23,
      "startMs": 68229,
      "endMs": 69960,
      "ar": "كَأَنَّهُمْ كَجِسْمٍ وَاحِدِ",
      "en": "Are as if they were a single body",
      "fr": "Sont comme un seul corps",
      "ru": "Словно единое тело",
      "de": "Sind wie ein einziger Körper",
      "id": "Seolah-olah mereka adalah satu tubuh",
      "nl": "Zijn als één enkel lichaam",
      "ckb": "وەکو یەک جەستەن",
      "fa": "گویی یک پیکر واحد هستند"
    },
    {
      "lineIndex": 24,
      "startMs": 69960,
      "endMs": 73440,
      "ar": "بِالظُّلْمِ كُنَّا نَصْطَلِي",
      "en": "We used to suffer in oppression",
      "fr": "Nous souffrions sous l'oppression",
      "ru": "Мы страдали от несправедливости",
      "de": "Unter der Ungerechtigkeit haben wir gelitten",
      "id": "Dahulu kita menderita dalam kezaliman",
      "nl": "Onder de onderdrukking leden wij",
      "ckb": "بە ستەمکاری دەسوتاین",
      "fa": "در آتش ظلم می‌سوختیم"
    },
    {
      "lineIndex": 25,
      "startMs": 73440,
      "endMs": 76024,
      "ar": "وَبِالظَّلاَمِ الجَاهِلِي",
      "en": "And in the darkness of ignorance",
      "fr": "Et dans les ténèbres de l'ignorance",
      "ru": "И во тьме невежества",
      "de": "Und in der Dunkelheit der Unwissenheit",
      "id": "Dan dalam kegelapan jahiliah",
      "nl": "En in de duisternis van onwetendheid",
      "ckb": "و بە تاریکی جەهلیەت",
      "fa": "و در تاریکی جاهلیت"
    },
    {
      "lineIndex": 26,
      "startMs": 76024,
      "endMs": 80432,
      "ar": "لَكِنَّنَا لَنْ نَنْثَنِي",
      "en": "But we will never bend",
      "fr": "Mais nous ne fléchirons jamais",
      "ru": "Но мы никогда не согнемся",
      "de": "Aber wir werden uns niemals beugen",
      "id": "Namun kita tidak akan pernah tunduk",
      "nl": "Maar wij zullen nooit buigen",
      "ckb": "بەڵام ئێمە هەرگیز نانەوێینەوە",
      "fa": "اما ما هرگز تسلیم نخواهیم شد"
    },
    {
      "lineIndex": 27,
      "startMs": 80432,
      "endMs": 83024,
      "ar": "فَكُلُّ لَيْلٍ يَنْجَلِي",
      "en": "For every night shall clear away",
      "fr": "Car toute nuit finit par se dissiper",
      "ru": "Ибо всякая ночь рассеется",
      "de": "Denn jede Nacht vergeht",
      "id": "Karena setiap malam pasti akan berlalu",
      "nl": "Want elke nacht verdwijnt",
      "ckb": "چونکە هەموو شەوێک ڕووناک دەبێتەوە",
      "fa": "چرا که هر شب سیاهی پایان می‌یابد"
    },
    {
      "lineIndex": 28,
      "startMs": 83024,
      "endMs": 87464,
      "ar": "بِالظُّلْمِ كُنَّا نَصْطَلِي",
      "en": "We used to suffer in oppression",
      "fr": "Nous souffrions sous l'oppression",
      "ru": "Мы страдали от несправедливости",
      "de": "Unter der Ungerechtigkeit haben wir gelitten",
      "id": "Dahulu kita menderita dalam kezaliman",
      "nl": "Onder de onderdrukking leden wij",
      "ckb": "بە ستەمکاری دەسوتاین",
      "fa": "در آتش ظلم می‌سوختیم"
    },
    {
      "lineIndex": 29,
      "startMs": 87464,
      "endMs": 90643,
      "ar": "فِي سِجْنِهِمْ قَدْ حَبَسُوا أُسُودَنَا",
      "en": "In their prison they jailed our lions",
      "fr": "Dans leur prison ils ont enfermé nos lions",
      "ru": "В своей тюрьме они заточили наших львов",
      "de": "In ihrem Gefängnis haben sie unsere Löwen eingesperrt",
      "id": "Di penjara mereka, mereka mengurung singa-singa kita",
      "nl": "In hun gevangenis opsloten ze onze leeuwen",
      "ckb": "لە زیندانیان شێرەکانمان بەند کردووە",
      "fa": "در زندانشان شیران ما را محبوس کردند"
    },
    {
      "lineIndex": 30,
      "startMs": 90643,
      "endMs": 94315,
      "ar": "وَهَلْ تُرَى تُحْبَسُ أُسْدٌ سِوَى أَنَّهَا تَفْتَرِسُ؟",
      "en": "And are lions ever caged except that they devour?",
      "fr": "Mais enferme-t-on des lions autrement que pour qu'ils dévorent?",
      "ru": "Разве запирают львов иначе, как ради того, чтобы они растерзали?",
      "de": "Sperrt man etwa Löwen ein, außer damit sie zurennen?",
      "id": "Dan apakah singa dikurung melainkan untuk menerkam?",
      "nl": "En worden leeuwen ooit opgesloten behalve om te verscheuren?",
      "ckb": "ئایا شێر بەند دەکرێت تەنها بۆ ئەوەی ڕاو بکات؟",
      "fa": "و آیا شیران حبس می‌شوند مگر برای آنکه خروشان‌تر شوند؟"
    },
    {
      "lineIndex": 31,
      "startMs": 94315,
      "endMs": 97824,
      "ar": "أَنَّ السَّجِينَ كَانَ يَشْهَدُ",
      "en": "That the prisoner was bearing witness",
      "fr": "Que le prisonnier témoignait",
      "ru": "Что узник свидетельствовал",
      "de": "Dass der Gefangene bezeugte",
      "id": "Bahwa sang tahanan bersaksi",
      "nl": "Dat de gevangene getuigde",
      "ckb": "کە زیندانییەکە شاهیدی دەدا",
      "fa": "همانا زندانی گواهی می‌داد"
    },
    {
      "lineIndex": 32,
      "startMs": 97824,
      "endMs": 101344,
      "ar": "بِأَنَّنَا لَنَا يَدُ",

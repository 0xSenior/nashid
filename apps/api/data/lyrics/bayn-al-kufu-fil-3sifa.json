    {
      "lineIndex": 20,
      "startMs": 62960,
      "endMs": 64621,
      "ar": "وَرَاحَةُ المُجَاهِدِ",
      "en": "And the rest of the strive-bound warrior",
      "fr": "Et le repos du combattant",
      "ru": "А отдых борца",
      "de": "Und die Ruhe des Kämpfers",

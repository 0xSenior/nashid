    {
      "lineIndex": 82,
      "startMs": 203760,
      "endMs": 206141,
      "ar": "أَتَشْرِي المَوْتَ يَا هَذَا",
      "en": "Do you buy death, O man?",
      "fr": "Achètes-tu la mort, ô toi ?",
      "ru": "Покупаешь ли ты смерть, о человек?",
      "de": "Kaufst du den Tod, o du?",
      "id": "Apakah engkau membeli kematian, wahai engkau?",
      "nl": "Koop je de dood, o mens?",
      "ckb": "ئایا مەرگ دەکڕیت ئەی مرۆڤ؟"
    },
    {
      "lineIndex": 83,
      "startMs": 206141,
      "endMs": 208160,
      "ar": "أَتَشْرِيهِ إِذَا بَاعُوا",
      "en": "Do you buy it when they sell it?",
      "fr": "L'achètes-tu s'ils la vendent ?",
      "ru": "Покупаешь ли ты её, когда они продают?",
      "de": "Kaufst du ihn, wenn sie ihn verkaufen?",
      "id": "Apakah engkau membelinya ketika mereka menjualnya?",
      "nl": "Koop je het als zij het verkopen?",
      "ckb": "ئایا دەیکڕیت کاتێک دەیفڕۆشن؟"
    },
    {
      "lineIndex": 84,
      "startMs": 208160,
      "endMs": 210501,
      "ar": "أَتَشْرِي الدَّاءَ مُغْتَبِطًا",
      "en": "Do you buy the illness joyfully?",
      "fr": "Achètes-tu le mal joyeusement ?",
      "ru": "Покупаешь ли ты болезнь с радостью?",
      "de": "Kaufst du die Krankheit voller Freude?",
      "id": "Apakah engkau membeli penyakit dengan gembira?",
      "nl": "Koop je de ziekte vol vreugde?",
      "ckb": "ئایا دەرد دەکڕیت بە خۆشحاڵییەوە؟"
    },
    {
      "lineIndex": 85,
      "startMs": 210501,
      "endMs": 215021,
      "ar": "وَعِنْدَكَ صِبْيَةٌ جَاعُوا",
      "en": "While you have children who go hungry?",
      "fr": "Alors que tes enfants ont faim ?",
      "ru": "Когда у тебя дома голодают дети?",
      "de": "Während deine Kinder hungern?",
      "id": "Padahal engkau memiliki anak-anak yang kelaparan?",
      "nl": "Terwijl je kinderen honger lijden?",
      "ckb": "لەکاتێکدا منداڵەکانت برسی بوون؟"
    },
    {
      "lineIndex": 86,
      "startMs": 215021,
      "endMs": 215832,
      "ar": "أَنَا مَرَضٌ أَنَا الدَّاءُ",
      "en": "I am a disease, I am the illness",
      "fr": "Je suis une maladie, je suis le mal",
      "ru": "Я — болезнь, я — недуг",
      "de": "Ich bin eine Krankheit, ich bin das Leiden",
      "id": "Aku adalah penyakit, akulah wabah",
      "nl": "Ik ben een ziekte, ik ben de kwaal",
      "ckb": "من نەخۆشیم، من دەرد و ئازارم"
    },
    {
      "lineIndex": 87,
      "startMs": 215832,
      "endMs": 217891,
      "ar": "وَمِنِّي تَأْتِي أَوْجَاعُ",
      "en": "And from me come pains",
      "fr": "Et de moi viennent les douleurs",
      "ru": "И от меня исходит боль",
      "de": "Und von mir kommen Schmerzen",
      "id": "Dan dariku datang rasa sakit",
      "nl": "En van mij komen pijnen",
      "ckb": "وە لە منەوە ئازارەکان دێن"
    },
    {
      "lineIndex": 88,
      "startMs": 217891,
      "endMs": 220240,
      "ar": "وَلَيْسَ لِمُدْمِنِي أَبَدًا",
      "en": "And my addict will never have",
      "fr": "Et mon intoxiqué n'aura jamais",
      "ru": "И у страдающего зависимостью обо мне никогда не будет",
      "de": "Und mein Süchtiger wird niemals",
      "id": "Dan pecanduku tidak akan pernah memiliki",
      "nl": "En wie aan mij verslaafd is zal nooit",
      "ckb": "وە هەرگیز بۆ ئاڵودەبووم"
    },
    {
      "lineIndex": 89,
      "startMs": 220240,
      "endMs": 222632,
      "ar": "مِنَ الأَخْيَارِ أَتْبَاعُ",
